---
layout: null
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="zh-CN">

  <title>azalea says</title>
  <link href="https://azaleasays.com/atom.xml" rel="self" type="application/atom+xml"/>
  <link href="https://azaleasays.com/" rel="alternate" type="text/html"/>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <id>http://azaleasays.com</id>
  <author>
    <name>azalea</name>
  </author>

  {% for post in site.posts limit:20 %}
  <entry>
    <title>{{ post.title | xml_escape }}</title>
    <link href="https://azaleasays.com{{ post.url }}" rel="alternate" type="text/html"/>
    <published>{{ post.date | date_to_xmlschema }}</published>
    <updated>{{ post.date | date_to_xmlschema }}</updated>
    <id>http://azaleasays.com{{ post.id }}</id>
    <content type="html">{{ post.content | replace: 'src="/', 'src="https://azaleasays.com/' | replace: 'href="/', 'href="https://azaleasays.com/' | xml_escape }}</content>
  </entry>
  {% endfor %}

</feed>
